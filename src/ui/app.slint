import { ImpactViewData, CameraDeviceViewData } from "types.slint";
import { TargetView } from "target_view.slint";
import { CameraSelection } from "camera_selection.slint";
import { ShootConfiguration } from "shoot_configuration.slint";
import { DataMetrics } from "data_metrics.slint";
import { ListImpactsView } from "list_impacts.slint";
import { CrudImpacts } from "impacts_crud.slint";
import {
    VerticalBox,
    HorizontalBox,
    Button,
    LineEdit,
} from "std-widgets.slint";

export struct ImpactData {
    x: float,
    y: float,
    distance: float,
}

export component Case inherits Rectangle {
    in property <string> label;
    in property <color> borderColor: #343d46;
    border-color: borderColor;
    border-width: 2px;
    border-radius: 3px;
    Text {
        color: red;
        text: label;
    }
}

export component MainWindow inherits Window {
    preferred-width: 1280px;
    preferred-height: 960px;
    min-width: 1100px;
    min-height: 600px;
    background: #202020;
    title: "Target Shooter";

    // ─────────────────────────────────────────────
    // État caméra
    // ─────────────────────────────────────────────

    in property <string> camera_status: "Caméra non connectée";
    in property <string> camera_fps: "-- FPS";
    in property <image> camera_image;
    in property <[CameraDeviceViewData]> camera-devices: [];
    in property <int> selected-camera: -1;
    in property <int> selected-impact: -1;
    in property <bool> moving-impact: false;
    // ─────────────────────────────────────────────
    // Configuration cible
    // ─────────────────────────────────────────────

    in-out property <float> target_distance: 100.0;
    in-out property <bool> camera-section-open: false;
    in-out property <bool> shooting-configuration-open: false;

    // ─────────────────────────────────────────────
    // Impacts
    // ─────────────────────────────────────────────

    in property <int> impact_count: 0;
    in property <string> grouping-diameter: "--";
    in property <string> grouping-center: "--";
    in property <string> grouping-offset: "--";
    in property <string> average-impact-offset: "--";
    in property <bool> average-impact-visible: false;
    in property <float> average-impact-image-x: 360;
    in property <float> average-impact-image-y: 240;

    in property <float> center_x: 360.0;
    in property <float> center_y: 240.0;
    in property <bool> setting-center: false;
    in property <[ImpactViewData]> impacts: [];
    // ─────────────────────────────────────────────
    // Calibration
    // ─────────────────────────────────────────────

    in property <bool> calibration-visible: false;
    in property <bool> calibration-complete: false;
    in property <string> calibration-step: "Aucune";
    in property <string> calibration-active-point: "";
    in property <string> calibration-instruction: "Cliquez sur \"Calibrer la cible\" pour démarrer.";

    in-out property <float> calibration-horizontal-distance: 100.0;
    in-out property <float> calibration-vertical-distance: 100.0;

    in property <float> horizontal-a-x: -1;
    in property <float> horizontal-a-y: -1;
    in property <bool> horizontal-a-visible: false;

    in property <float> horizontal-b-x: -1;
    in property <float> horizontal-b-y: -1;
    in property <bool> horizontal-b-visible: false;

    in property <float> vertical-a-x: -1;
    in property <float> vertical-a-y: -1;
    in property <bool> vertical-a-visible: false;

    in property <float> vertical-b-x: -1;
    in property <float> vertical-b-y: -1;
    in property <bool> vertical-b-visible: false;
    // ─────────────────────────────────────────────
    // Actions
    // ─────────────────────────────────────────────

    callback impact-selected(int); //on_impact_selected
    callback connect-camera(); //on_connect_camera
    callback camera-selected(int); //on_camera_selected
    callback capture_target(); //on_capture_target
    // callback set_center(float, float);
    // callback add_impact(float, float);
    callback clear_impacts(); //on_clear_impacts
    callback delete-selected-impact(); //on_delete_selected_impact
    callback move-selected-impact(); //on_move_selected_impact
    callback target_clicked(float, float); //on_target_clicked
    // callback request-set-center();
    callback request-calibration(); //on_request_calibration
    callback cancel-calibration(); //on_cancel_calibration
    callback calibration-distances-validated(); //on_calibration_distances_validated
    callback target-distance-validated(); //on_target_distance_validated


    VerticalLayout {
        spacing: 2px;
        padding: 5px;
        HorizontalBox {
            min-height: 50px;
            Text {
                text: "Target Shooter";
                font-size: 24px;
                vertical-alignment: center;
            }

            Case {
            Camera-Selection := CameraSelection {
                section-open: root.camera-section-open;
                camera-devices: root.camera-devices;
                selected-camera: root.selected-camera;

                camera-selected(index) => {
                    root.camera-selected(index);
                }
            }

            }

            Case {
                Shoot-Configuration := ShootConfiguration {
                    section-open: root.shooting-configuration-open;
                    target-distance: root.target-distance;
                    calibration-horizontal-distance: root.calibration-horizontal-distance;
                    calibration-vertical-distance: root.calibration-vertical-distance;
                    calibration-visible: root.calibration-visible;
                    calibration-complete: root.calibration-complete;
                    calibration-step: root.calibration-step;
                    calibration-instruction: root.calibration-instruction;

                    request-calibration() => {
                        root.request_calibration();
                    }

                    cancel-calibration() => {
                        root.cancel_calibration();
                    }

                    calibration-distances-validated() => {
                        root.calibration_distances_validated();
                    }

                    target-distance-validated() => {
                        root.target_distance_validated();
                    }
                }
            }
        }

        HorizontalBox {
            min-height: 50px;
            crud-impacts := CrudImpacts {
                selected-impact: root.selected-impact;
                moving-impact: root.moving-impact;
                capture_target => {
                    root.capture_target();
                }
                clear_impacts => {
                    root.clear_impacts();
                }
                move-selected-impact => {
                    root.move-selected-impact();
                }
                delete-selected-impact => {
                    root.delete-selected-impact();
                }
            }
        }

        HorizontalBox {
            spacing: 12px;
            vertical-stretch: 1;

            // ─────────────────────────────────────────
        // Zone caméra / cible
        // ─────────────────────────────────────────
            Case {
                View-Video := TargetView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    selected-impact: root.selected-impact - 1;
                    camera-image: camera-image;
                    image-width: 720;
                    image-height: 480;

                    center-x: center-x;
                    center-y: center_y;

                    center-visible: true;
                    setting-center: setting-center;
                    average-impact-visible: average-impact-visible;
                    average-impact-image-x: average-impact-image-x;
                    average-impact-image-y: average-impact-image-y;
                    impacts: impacts;

                    // ─────────────────────────────────────────
            // Calibration
            // ─────────────────────────────────────────

            calibration-visible: calibration-visible;
                    calibration-step: calibration-step;
                    calibration-active-point: calibration-active-point;
                    calibration-instruction: calibration-instruction;
                    calibration-complete: calibration-complete;

                    horizontal-a-x: horizontal-a-x;
                    horizontal-a-y: horizontal-a-y;
                    horizontal-a-visible: horizontal-a-visible;

                    horizontal-b-x: horizontal-b-x;
                    horizontal-b-y: horizontal-b-y;
                    horizontal-b-visible: horizontal-b-visible;

                    vertical-a-x: vertical-a-x;
                    vertical-a-y: vertical-a-y;
                    vertical-a-visible: vertical-a-visible;

                    vertical-b-x: vertical-b-x;
                    vertical-b-y: vertical-b-y;
                    vertical-b-visible: vertical-b-visible;

                    // ─────────────────────────────────────────
            // Clic dans l'image
            // ─────────────────────────────────────────
            impact-selected(index) => {
                        root.impact-selected(index + 1);
                    }

                    image-clicked(x, y) => {
                        target_clicked(x, y);
                    }
                }
            }

            Case {
                width: 300px;
                VerticalBox {
                    Case {
                        min-height: 300px;
                        List-Impacts := ListImpactsView {
                            impacts: root.impacts;
                            selected-impact: root.selected-impact;
                            impact-selected(index) => {
                                root.impact-selected(index);
                            }
                        }
                    }

                    Case {
                        Data-Metrics := DataMetrics {
                            max-height: 80px;
                            impact_count: root.impact_count;
                            grouping_center: root.grouping-center;
                            grouping_offset: root.grouping-offset;
                            grouping_diameter: root.grouping-diameter;
                            average-impact-offset: root.average-impact-offset;
                        }
                    }
                }
            }
        }
    }
}
