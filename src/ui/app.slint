import { ImpactViewData, CameraDeviceViewData } from "types.slint";
import { TargetView } from "target_view.slint";

import {
    VerticalBox,
    HorizontalBox,
    Button,
    LineEdit,
} from "std-widgets.slint";

export struct ImpactData {
    x: float,
    y: float,
    distance: float,
}

export component MainWindow inherits Window {
    preferred-width: 1400px;
    preferred-height: 900px;
    title: "Target Shooter";

    // ─────────────────────────────────────────────
    // État caméra
    // ─────────────────────────────────────────────

    in property <string> camera_status: "Caméra non connectée";
    in property <string> camera_fps: "-- FPS";
    in property <image> camera_image;
    in property <[CameraDeviceViewData]> camera-devices: [];
    in property <int> selected-camera: -1;
    in property <int> selected-impact: -1;
    // ─────────────────────────────────────────────
    // Configuration cible
    // ─────────────────────────────────────────────

    in-out property <float> target_distance: 100.0;
    in-out property <bool> camera-section-open: false;
    in-out property <bool> shooting-configuration-open: false;

    // ─────────────────────────────────────────────
    // Impacts
    // ─────────────────────────────────────────────

    in property <int> impact_count: 0;
    in property <string> grouping-diameter: "--";
    in property <string> grouping-center: "--";
    in property <string> grouping-offset: "--";
    in property <float> grouping-center-x: 0;
    in property <float> grouping-center-y: 0;
    in property <bool> grouping-center-visible: false;
    in property <float> grouping-center-image-x: 360;
    in property <float> grouping-center-image-y: 240;

    in property <float> center_x: 360.0;
    in property <float> center_y: 240.0;
    in property <bool> setting-center: false;
    in property <[ImpactViewData]> impacts: [];
    // ─────────────────────────────────────────────
    // Calibration
    // ─────────────────────────────────────────────

    in property <bool> calibration-visible: false;
    in property <bool> calibration-complete: false;
    in property <string> calibration-step: "Aucune";
    in property <string> calibration-active-point: "";
    in property <string> calibration-instruction: "Cliquez sur \"Calibrer la cible\" pour démarrer.";

    in-out property <float> calibration-horizontal-distance: 100.0;
    in-out property <float> calibration-vertical-distance: 100.0;

    in property <float> horizontal-a-x: -1;
    in property <float> horizontal-a-y: -1;
    in property <bool> horizontal-a-visible: false;

    in property <float> horizontal-b-x: -1;
    in property <float> horizontal-b-y: -1;
    in property <bool> horizontal-b-visible: false;

    in property <float> vertical-a-x: -1;
    in property <float> vertical-a-y: -1;
    in property <bool> vertical-a-visible: false;

    in property <float> vertical-b-x: -1;
    in property <float> vertical-b-y: -1;
    in property <bool> vertical-b-visible: false;
    // ─────────────────────────────────────────────
    // Actions
    // ─────────────────────────────────────────────

    callback impact-selected(int);

    callback connect-camera();
    callback camera-selected(int);
    callback capture_target();
    callback set_center(float, float);
    callback add_impact(float, float);
    callback clear_impacts();
    callback target_clicked(float, float);
    callback request-set-center();
    callback request-calibration();
    callback cancel-calibration();
    callback calibration-distances-validated();
    callback target-distance-validated();

    VerticalBox {
        spacing: 8px;
        padding: 12px;

        // ═══════════════════════════════════════════
        // Barre supérieure
        // ═══════════════════════════════════════════

        HorizontalBox {
            height: 40px;
            spacing: 12px;

            Text {
                text: "Target Shooter";
                font-size: 24px;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Text {
                text: camera_status;
                vertical-alignment: center;
            }

            Text {
                text: camera_fps;
                vertical-alignment: center;
            }

            Button {
                text: "Rafraîchir";

                clicked => {
                    connect-camera();
                }
            }
        }

        // ═══════════════════════════════════════════
        // Zone principale
        // ═══════════════════════════════════════════

        HorizontalBox {
            spacing: 12px;
            vertical-stretch: 1;

            // ─────────────────────────────────────────
            // Zone caméra / cible
            // ─────────────────────────────────────────

            TargetView {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                selected-impact: root.selected-impact - 1;
                camera-image: camera-image;
                image-width: 720;
                image-height: 480;

                center-x: center-x;
                center-y: center_y;

                center-visible: true;
                setting-center: setting-center;
                impacts: impacts;

                // ─────────────────────────────────────────
                // Calibration
                // ─────────────────────────────────────────

                calibration-visible: calibration-visible;
                calibration-step: calibration-step;
                calibration-active-point: calibration-active-point;
                calibration-instruction: calibration-instruction;
                calibration-complete: calibration-complete;

                horizontal-a-x: horizontal-a-x;
                horizontal-a-y: horizontal-a-y;
                horizontal-a-visible: horizontal-a-visible;

                horizontal-b-x: horizontal-b-x;
                horizontal-b-y: horizontal-b-y;
                horizontal-b-visible: horizontal-b-visible;

                vertical-a-x: vertical-a-x;
                vertical-a-y: vertical-a-y;
                vertical-a-visible: vertical-a-visible;

                vertical-b-x: vertical-b-x;
                vertical-b-y: vertical-b-y;
                vertical-b-visible: vertical-b-visible;


                // ─────────────────────────────────────────
                // Clic dans l'image
                // ─────────────────────────────────────────
                impact-selected(index) => {
                        root.impact-selected(index + 1);
                    }

                image-clicked(x, y) => {
                    target_clicked(x, y);
                }
            }

            // ─────────────────────────────────────────
            // Panneau de droite
            // ─────────────────────────────────────────

            Rectangle {
                width: 320px;
                background: #242424;

                VerticalBox {
                    padding: 16px;
                    spacing: 12px;

                    Text {
                        text: "Contrôles";
                        font-size: 20px;
                    }

                    Rectangle {
                        background: #202020;
                        border-radius: 8px;

                        VerticalBox {
                            padding: 8px;
                            spacing: 4px;

                            Rectangle {
                                height: 24px;
                                background: transparent;

                                TouchArea {
                                    width: parent.width;
                                    height: parent.height;

                                    clicked => {
                                        root.camera-section-open = !root.camera-section-open;
                                    }
                                }

                                Text {
                                    x: 0px;
                                    y: 3px;
                                    text: (root.camera-section-open ? "▼ " : "▶ ") + "Caméras";
                                    font-size: 16px;
                                    color: white;
                                }
                            }

                            if root.camera-section-open : Rectangle {
                                height: 64px;
                                background: #181818;
                                border-radius: 6px;
                                clip: true;

                                VerticalBox {
                                    padding: 3px;
                                    spacing: 3px;

                                    for camera in camera-devices : Rectangle {
                                        height: 24px;
                                        border-radius: 4px;

                                        background: root.selected-camera == camera.index
                                            ? #304860
                                            : #252525;

                                        TouchArea {
                                            width: parent.width;
                                            height: parent.height;

                                            clicked => {
                                                root.camera-selected(camera.index);
                                            }
                                        }

                                        Text {
                                            x: 8px;
                                            y: 4px;
                                            width: parent.width - 16px;
                                            text: camera.name;
                                            color: white;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        background: #202020;
                        border-radius: 8px;

                        VerticalBox {
                            padding: 12px;
                            spacing: 8px;

                            Rectangle {
                                height: 32px;
                                background: transparent;

                                TouchArea {
                                    width: parent.width;
                                    height: parent.height;

                                    clicked => {
                                        root.shooting-configuration-open = !root.shooting-configuration-open;
                                    }
                                }

                                Text {
                                    x: 0px;
                                    y: 6px;
                                    text: (root.shooting-configuration-open ? "▼ " : "▶ ") + "Configuration de tir";
                                    font-size: 18px;
                                    color: white;
                                }
                            }

                            if root.shooting-configuration-open : VerticalBox {
                                spacing: 8px;

                                Text {
                                    text: "Distance de tir";
                                    color: #bbbbbb;
                                }

                                HorizontalBox {
                                    spacing: 8px;

                                    target-distance-input := LineEdit {
                                        horizontal-stretch: 1;
                                        text: root.target-distance;

                                        accepted => {
                                            let value = self.text.to-float();

                                            if value > 0 {
                                                root.target-distance = value;
                                                root.target-distance-validated();
                                            }
                                        }
                                    }

                                    Text {
                                        width: 28px;
                                        text: "m";
                                        vertical-alignment: center;
                                    }

                                    Button {
                                        text: "Valider";

                                        clicked => {
                                            let value = target-distance-input.text.to-float();

                                            if value > 0 {
                                                root.target-distance = value;
                                                root.target-distance-validated();
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 1px;
                                    background: #3a3a3a;
                                }

                                Text {
                                    text: "Calibration";
                                    color: #bbbbbb;
                                }

                                HorizontalBox {
                                    spacing: 8px;

                                    horizontal-distance-input := LineEdit {
                                        horizontal-stretch: 1;
                                        text: root.calibration-horizontal-distance;

                                        accepted => {
                                            let value = self.text.to-float();

                                            if value > 0 {
                                                root.calibration-horizontal-distance = value;
                                                root.calibration-distances-validated();
                                            }
                                        }
                                    }

                                    Text {
                                        width: 28px;
                                        text: "H";
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        width: 28px;
                                        text: "mm";
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalBox {
                                    spacing: 8px;

                                    vertical-distance-input := LineEdit {
                                        horizontal-stretch: 1;
                                        text: root.calibration-vertical-distance;

                                        accepted => {
                                            let value = self.text.to-float();

                                            if value > 0 {
                                                root.calibration-vertical-distance = value;
                                                root.calibration-distances-validated();
                                            }
                                        }
                                    }

                                    Text {
                                        width: 28px;
                                        text: "V";
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        width: 28px;
                                        text: "mm";
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalBox {
                                    spacing: 8px;

                                    Button {
                                        text: calibration-visible && !calibration-complete
                                            ? "Recommencer"
                                            : calibration-complete
                                                ? "Recalibrer"
                                                : "Calibrer la cible";

                                        clicked => {
                                            request-calibration();
                                        }
                                    }

                                    Button {
                                        text: "Appliquer";

                                        clicked => {
                                            let horizontal-value = horizontal-distance-input.text.to-float();
                                            let vertical-value = vertical-distance-input.text.to-float();

                                            if horizontal-value > 0 && vertical-value > 0 {
                                                root.calibration-horizontal-distance = horizontal-value;
                                                root.calibration-vertical-distance = vertical-value;
                                                root.calibration-distances-validated();
                                            }
                                        }
                                    }
                                }

                                if calibration-visible && !calibration-complete : Button {
                                    text: "Annuler la calibration";

                                    clicked => {
                                        cancel-calibration();
                                    }
                                }

                                Text {
                                    text: "Étape : " + calibration-step;
                                    color: #bbbbbb;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: calibration-instruction;
                                    color: calibration-complete ? #80ffb0 : #80cfff;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: #202020;
                        border-radius: 8px;

                        VerticalBox {
                            padding: 12px;
                            spacing: 8px;

                            Text {
                                text: "Impacts";
                                font-size: 18px;
                            }

                            Button {
                                text: "Capturer la cible";

                                clicked => {
                                    capture_target();
                                }
                            }

                            Button {
                                text: "Effacer les impacts";

                                clicked => {
                                    clear_impacts();
                                }
                            }

                            Rectangle {
                                vertical-stretch: 1;
                                background: #181818;
                                border-radius: 6px;
                                clip: true;

                                VerticalBox {
                                    padding: 6px;
                                    spacing: 4px;

                                    for impact in impacts : Rectangle {
                                        height: 32px;
                                        border-radius: 4px;

                                        background: root.selected-impact == impact.number
                                            ? #554800
                                            : #252525;

                                        TouchArea {
                                            width: parent.width;
                                            height: parent.height;

                                            clicked => {
                                                root.impact-selected(impact.number);
                                            }
                                        }

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            alignment: center;

                                            Text {
                                                width: 45px;
                                                text: "#" + impact.number;
                                                color: white;
                                            }

                                            Text {
                                                width: 110px;
                                                text: "X " + impact.target-x;
                                                color: #80cfff;
                                            }

                                            Text {
                                                width: 110px;
                                                text: "Y " + impact.target-y;
                                                color: #80ffb0;
                                            }
                                        }
                                    }
                                }
                            }

                            Text {
                                text: "Nombre : " + impact_count;
                            }

                            Text {
                                text: "Décalage : " + grouping-offset;
                                font-size: 18px;
                            }

                            Text {
                                text: "Dispersion : " + grouping-diameter;
                            }

                            Text {
                                text: "Écart au point visé : " + grouping-center;
                            }
                        }
                    }
                }
            }
        }

        // ═══════════════════════════════════════════
        // Barre inférieure
        // ═══════════════════════════════════════════

        Text {
            text: "720 × 480";
            height: 25px;
            vertical-alignment: center;
        }
    }
}
